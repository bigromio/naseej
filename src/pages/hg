// أ. مسار إرسال الرسائل (واتساب + إيميل)
app.post('/send', async (req, res) => {
    let { brand, phone, email, message, subject, html, mediaUrl } = req.body;
    let whatsappStatus = 'تخطي';
    let emailStatus = 'تخطي';

    // 🌟 التوافق مع الأنظمة القديمة: إذا لم يتم تحديد براند، اعتبره أوكرة
    if (!brand) brand = 'ukra';

    console.log(`\n📥 [طلب جديد] مرسل من براند: ${brand}`);

    // --- إرسال الواتساب ---
    if (phone && (message || mediaUrl)) {
        const client = waClients.get(brand);
        if (!client) {
            whatsappStatus = 'البراند غير مفعل أو غير متصل';
        } else {
            try {
                let cleanPhone = phone.replace(/\D/g, '');
                if (cleanPhone.startsWith('05')) cleanPhone = '966' + cleanPhone.substring(1);
                const chatId = cleanPhone.includes('@') ? cleanPhone : `${cleanPhone}@c.us`;

                if (mediaUrl) {
                    let media;
                    if (mediaUrl.startsWith('data:')) {
                        const mimeType = mediaUrl.split(';')[0].split(':')[1];
                        const base64Data = mediaUrl.split(',')[1];
                        media = new MessageMedia(mimeType, base64Data, 'Document.pdf');
                    } else {
                        media = await MessageMedia.fromUrl(mediaUrl, { unsafeMime: true });
                    }
                    await client.sendMessage(chatId, media, { caption: message || '' });
                } else {
                    await client.sendMessage(chatId, message);
                }
                whatsappStatus = 'نجاح';
                console.log(`✅ [واتساب] تم الإرسال للرقم: ${phone}`);
            } catch (error) {
                console.error('⚠️ [واتساب] فشل الإرسال:', error.message);
                whatsappStatus = 'فشل';
            }
        }
    }

    // --- إرسال الإيميل (ديناميكي بناءً على إعدادات البراند) ---
    if (email && (message || html)) {
        try {
            const { data: brandSettings } = await supabase.from('integration_settings').select('*').eq('project_name', brand).single();
            
            if (brandSettings && brandSettings.smtp_host) {
                const transporter = nodemailer.createTransport({
                    host: brandSettings.smtp_host,
                    port: brandSettings.smtp_port,
                    secure: brandSettings.smtp_port === 465,
                    auth: { user: brandSettings.smtp_user, pass: brandSettings.smtp_pass }
                });

                await transporter.sendMail({
                    from: `"${brandSettings.smtp_from_name}" <${brandSettings.smtp_user}>`,
                    to: email,
                    subject: subject || `إشعار من ${brandSettings.smtp_from_name}`,
                    text: message || '',
                    html: html || message
                });
                emailStatus = 'نجاح';
                console.log(`✅ [إيميل] تم الإرسال إلى: ${email}`);
            } else {
                emailStatus = 'لا توجد إعدادات SMTP';
            }
        } catch (error) {
            console.error('⚠️ [إيميل] فشل الإرسال:', error.message);
            emailStatus = 'فشل';
        }
    }

    res.json({ success: true, brand, whatsapp: whatsappStatus, email: emailStatus });
});

