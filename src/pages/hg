// دالة لتحديث حالة الواتساب في Supabase
async function updateWaStatus(projectName, status, qrCode = '') {
    await supabase.from('integration_settings')
        .update({ wa_status: status, wa_qr_code: qrCode })
        .eq('project_name', projectName);
}

// دالة تشغيل محرك واتساب مخصص لبراند معين
async function initializeWhatsAppClient(project) {
    const { project_name, wa_session_id, pm2_restart_minutes } = project;
    
    console.log(`\n🔄 جاري تشغيل محرك الواتساب لبراند: [${project_name.toUpperCase()}]...`);
    
    // إذا كان يعمل مسبقاً، نغلقه أولاً لتفريغ الذاكرة
    if (waClients.has(project_name)) {
        console.log(`🧹 تفريغ ذاكرة المتصفح لبراند [${project_name}]...`);
        await waClients.get(project_name).destroy();
        waClients.delete(project_name);
    }

    const client = new Client({
        authStrategy: new LocalAuth({ clientId: wa_session_id }),
        authTimeoutMs: 60000,
        puppeteer: {
            executablePath: '/usr/bin/google-chrome',
            headless: true,
            args: ['--no-sandbox', '--disable-setuid-sandbox', '--disable-dev-shm-usage', '--disable-gpu']
        }
    });

    client.on('qr', async (qr) => {
        console.log(`📱 تم توليد QR لبراند [${project_name}]. جاري إرساله للوحة التحكم...`);
        await updateWaStatus(project_name, 'qr_ready', qr);
    });

    client.on('ready', async () => {
        console.log(`✅ [${project_name}] واتساب متصل وجاهز للعمل!`);
        await updateWaStatus(project_name, 'connected', '');
        
        // 🌟 نظام تفريغ الذاكرة المعزول (Per-Brand Memory Management)
        if (restartTimers.has(project_name)) clearInterval(restartTimers.get(project_name));
        
        const intervalMs = (pm2_restart_minutes || 30) * 60 * 1000;
        const timer = setInterval(() => {
            console.log(`\n⏳ [جدولة] تفريغ الذاكرة لبراند ${project_name}...`);
            initializeWhatsAppClient(project); // إعادة التشغيل الذاتية
        }, intervalMs);
        
        restartTimers.set(project_name, timer);
    });

    client.on('disconnected', async (reason) => {
        console.log(`⚠️ [${project_name}] تم قطع اتصال الواتساب:`, reason);
        await updateWaStatus(project_name, 'disconnected', '');
        if (restartTimers.has(project_name)) clearInterval(restartTimers.get(project_name));
    });

    await client.initialize();
    waClients.set(project_name, client);
}

// ==========================================
// 3. محرك المزامنة (Sync Engine)
// ==========================================
async function syncIntegrations() {
    console.log('\n📡 جاري المزامنة مع قاعدة بيانات Supabase...');
    const { data: settings, error } = await supabase.from('integration_settings').select('*');
    
    if (error) {
        console.error('❌ خطأ في الاتصال بقاعدة البيانات:', error.message);
        return;
    }

    // تشغيل متصفح واتساب لكل براند موجود في القاعدة
    for (const project of settings) {
        if (!waClients.has(project.project_name)) {
            await initializeWhatsAppClient(project);
        }
    }
}

// بدء المزامنة عند تشغيل السيرفر
