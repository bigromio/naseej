// 5. محرك طابور الحملات الإعلانية (Background Job Worker)
// ==========================================
let isProcessingQueue = false;

async function processCampaignQueue() {
    // إذا كان المحرك مشغولاً بإرسال رسالة، انتظر
    if (isProcessingQueue) return;
    isProcessingQueue = true;

    try {
        // 1. البحث عن حملة قيد الانتظار أو قيد التشغيل
        const { data: campaigns, error } = await supabase
            .from('campaign_queues')
            .select('*')
            .in('status', ['pending', 'processing'])
            .order('created_at', { ascending: true })
            .limit(1);

        if (error || !campaigns || campaigns.length === 0) {
            isProcessingQueue = false;
            return; // لا يوجد حملات حالياً
        }

        const campaign = campaigns[0];

        // 2. تحديث الحالة إلى processing إذا كانت pending
        if (campaign.status === 'pending') {
            await supabase.from('campaign_queues').update({ status: 'processing' }).eq('id', campaign.id);
            console.log(`\n🚀 [الحملات] بدء تشغيل حملة جديدة لبراند: ${campaign.project_name}`);
        }

        const audience = campaign.target_audience || [];
        let currentIndex = campaign.processed_count || 0;

        // 3. التحقق مما إذا انتهت الحملة
        if (currentIndex >= campaign.total_count || currentIndex >= audience.length) {
            await supabase.from('campaign_queues').update({ status: 'completed' }).eq('id', campaign.id);
            console.log(`✅ [الحملات] تم الانتهاء من حملة البراند: ${campaign.project_name} بنجاح!`);
            isProcessingQueue = false;
            return;
        }

        // 4. سحب العميل الذي عليه الدور
        const customer = audience[currentIndex];
        const { project_name: brand, channel, message, media_url, delay_seconds } = campaign;

        console.log(`⏳ [طابور الحملات] إرسال لـ ${customer.name} (${currentIndex + 1}/${campaign.total_count}) - القناة: ${channel}`);

        // تخصيص الرسالة باسم العميل
        let finalMessage = message.replace(/{{customer_name}}/g, customer.name || 'عميلنا العزيز');

        // 5. الإرسال الفعلي
        if (channel === 'whatsapp' && customer.contact) {
            const client = waClients.get(brand);
            if (client) {
                let cleanPhone = customer.contact.replace(/\D/g, '');
                if (cleanPhone.startsWith('05')) cleanPhone = '966' + cleanPhone.substring(1);
                const chatId = cleanPhone.includes('@') ? cleanPhone : `${cleanPhone}@c.us`;

                try {
                    if (media_url) {
                        let media;
                        if (media_url.startsWith('data:')) {
                            const mimeType = media_url.split(';')[0].split(':')[1];
                            const base64Data = media_url.split(',')[1];
                            media = new MessageMedia(mimeType, base64Data, 'Document.pdf');
                        } else {
                            media = await MessageMedia.fromUrl(media_url, { unsafeMime: true });
                        }
                        await client.sendMessage(chatId, media, { caption: finalMessage });
                    } else {
                        await client.sendMessage(chatId, finalMessage);
                    }
                } catch (err) {
                    console.error(`⚠️ خطأ إرسال واتساب لـ ${customer.contact}:`, err.message);
                }
            }
        } else if (channel === 'email' && customer.contact) {
            try {
                const { data: brandSettings } = await supabase.from('integration_settings').select('*').eq('project_name', brand).single();
                if (brandSettings && brandSettings.smtp_host) {
                    const transporter = nodemailer.createTransport({
                        host: brandSettings.smtp_host,
                        port: brandSettings.smtp_port,
                        secure: brandSettings.smtp_port === 465,
                        auth: { user: brandSettings.smtp_user, pass: brandSettings.smtp_pass }
                    });
                    await transporter.sendMail({
                        from: `"${brandSettings.smtp_from_name}" <${brandSettings.smtp_user}>`,
                        to: customer.contact,
                        subject: `إشعار من ${brandSettings.smtp_from_name}`,
                        html: `<div dir="rtl" style="font-family: Tahoma; line-height: 1.8;">${finalMessage.replace(/\n/g, '<br>')}</div>`
                    });
                }
            } catch (err) {
                console.error(`⚠️ خطأ إرسال إيميل لـ ${customer.contact}:`, err.message);
            }
        }

        // 6. تحديث العداد في قاعدة البيانات (لحفظ التقدم في حال انطفأ السيرفر)
        await supabase.from('campaign_queues').update({ processed_count: currentIndex + 1 }).eq('id', campaign.id);

        // 7. الانتظار (تأخير الإرسال المضاد للحظر) ثم تحرير المحرك للرسالة التالية
        const waitTime = (delay_seconds || 5) * 1000;
        setTimeout(() => {
            isProcessingQueue = false; 
        }, waitTime);

    } catch (error) {
        console.error('❌ خطأ في محرك الطابور:', error);
        isProcessingQueue = false;
    }
}

// تشغيل الفاحص الذكي كل 3 ثوانٍ (سيبدأ العمل فقط إذا لم يكن مشغولاً وتوفرت حملة)
